NODE_ENV=production
PORT=5002
HOST=127.0.0.1
TRUST_PROXY=1

# Database
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/bybs

# Public site URL used for links, cookies, and email content
FRONTEND_URL=https://buildyourbestself.org

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=https://buildyourbestself.org,https://www.buildyourbestself.org

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
AUTH_COOKIE_MAX_AGE_MS=28800000
SHUTDOWN_TIMEOUT_MS=10000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET_KEY=your-cloudinary-secret-key

# Email
RESEND_API_KEY=re_your_resend_key
FROM_EMAIL=BYBS <hello@buildyourbestself.org>
ARTICLE_NEWSLETTER_FROM_EMAIL=BYBS Newsletter <hello@buildyourbestself.org>
ADMIN_EMAIL=admin@buildyourbestself.org
