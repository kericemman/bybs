NODE_ENV=production
PORT=5002

# Database
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/bybs

# Public site URL used for payment callbacks and emails
FRONTEND_URL=https://yourdomain.com

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET_KEY=your-cloudinary-secret-key

# Paystack
PAYSTACK_PUBLIC_KEY=pk_live_or_test_key
PAYSTACK_SECRET_KEY=sk_live_or_test_key

# Email
RESEND_API_KEY=re_your_resend_key
FROM_EMAIL=BYBS <hello@yourdomain.com>
ARTICLE_NEWSLETTER_FROM_EMAIL=BYBS Newsletter <hello@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com
